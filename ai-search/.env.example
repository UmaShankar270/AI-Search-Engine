# AI Module Environment Configuration
# Copy to .env and fill in values

# Model configuration
AI_MODEL_NAME=all-MiniLM-L6-v2
AI_EMBEDDING_DIM=384
AI_FAISS_INDEX_TYPE=Flat
AI_TOP_K_DEFAULT=10
AI_RERANK_TOP_K=50
AI_CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# LLM Provider (openai or gemini)
AI_LLM_PROVIDER=openai

# OpenAI API Settings
AI_OPENAI_API_KEY=
AI_OPENAI_MODEL=gpt-4o-mini

# Gemini API Settings (accessed via OpenAI-compatible endpoint)
AI_GEMINI_API_KEY=
AI_GEMINI_MODEL=gemini-2.0-flash


# Cache settings
AI_CACHE_TTL_SECONDS=3600
AI_CACHE_MAX_SIZE_MB=512

# Logging
AI_LOG_LEVEL=INFO
AI_LOG_FILE=logs/ai.log

# Feature flags
AI_USE_RERANKING=true
AI_USE_LLM_SUMMARIES=true
AI_SUMMARY_MAX_TOKENS=150
AI_SUMMARY_TEMPERATURE=0.3
